  "scripts": {
    "postinstall": "check-engine --ignore",
    "prestart": "npm run prepare:i18n",
    "start": "webpack serve --env development",
    "start:build": "http-server dist -p 5000 -P http://localhost:8080 -o",
    "prebuild": "npm-run-all prepare:*",
    "prepare:tmp": "rm -rf .tmp",
    "prepare:i18n": "node scripts/merge-messages.js",
    "prepare:workbox": "workbox copyLibraries .tmp && mv .tmp/workbox-v${npm_package_config_workboxCli} .tmp/workbox",
    "build": "webpack --env production",
    "postbuild": "npm-run-all fix:*",
    "fix:preview": "replace 'elements/' '${window.location.pathname}/' dist/index.html",
    "fix:elements": "replace '/elements/' '${window.location.pathname}/' dist/*.js",
    "fix:ui_elements": "replace '/node_modules/@nuxeo/nuxeo-ui-elements/' '${window.location.pathname}/' dist/*.js",
    "fix:pdfjs": "replace 'pdfjs/web/viewer.html' '../vendor/pdfjs/web/viewer.html' dist/*.js",
    "fix:cropper": "replace '/node_modules/cropperjs/dist/cropper.css' 'vendor/cropperjs/dist/cropper.css' dist/*.js",
    "fix:fonts": "replace '\\.\\./fonts' './fonts' dist/*.js",
    "build:analyze": "webpack --env production --analyze",
    "lint:eslint": "eslint --ext .js,.html .",
    "format:eslint": "eslint --ext .js,.html . --fix",
    "lint:prettier": "prettier \"**/*.{js,html}\" --list-different || (echo '↑↑ these files are not prettier formatted ↑↑' && exit 1)",
    "format:prettier": "prettier \"**/*.{js,html}\" --write",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "win-lint": "npm run lint:eslint && npm run lint:prettier",
    "format": "npm run format:prettier && npm run format:eslint",
    "win-format": "npm run format:prettier && npm run format:eslint",
    "preinstall": "cd ./packages/nuxeo-web-ui-ftest && npm install && cd ../nuxeo-designer-catalog && npm install && cd ../../plugin/a11y && npm install",
    "ftest": "node scripts/test-runner.js --report --screenshots --headless --tags='not @ignore'",
    "ftest:headful": "node scripts/test-runner.js --report --screenshots --tags='not @ignore'",
    "ftest:dev": "node scripts/test-runner.js --nuxeoUrl=http://localhost:8080/nuxeo --url=http://localhost:5000/",
    "ftest:watch": "node scripts/test-runner.js --nuxeoUrl=http://localhost:8080/nuxeo  --url=http://localhost:5000/ --tags='@watch' --debug",
    "update-coverage-imports": "node scripts/generate-coverage-imports.js",
    "test": "npm run update-coverage-imports && karma start --coverage",
    "test:watch": "karma start --auto-watch=true --single-run=false",
    "coverage:open": "open coverage/index.html",
    "coverage:report": "npm run test && npm run coverage:open"
    },
