<?xml version="1.0"?>
<!--
  Schema backing the `webUIAnnouncement` directory, which stores the single
  administrator-managed announcement banner displayed in the Web UI header.

  `message`, `linkUrl` and `linkLabel` are capped at 255 characters so the
  generated directory columns stay within the default VARCHAR(255) width used by
  SQL directories.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  targetNamespace="http://nuxeo.org/schemas/webui/announcement"
  xmlns:webUIAnnouncement="http://nuxeo.org/schemas/webui/announcement">

  <xs:simpleType name="shortText">
    <xs:restriction base="xs:string">
      <xs:maxLength value="255"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="id" type="xs:string"/>
  <xs:element name="enabled" type="xs:boolean" default="false"/>
  <xs:element name="message" type="webUIAnnouncement:shortText"/>
  <xs:element name="linkUrl" type="webUIAnnouncement:shortText"/>
  <xs:element name="linkLabel" type="webUIAnnouncement:shortText"/>

</xs:schema>
